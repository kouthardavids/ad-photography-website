{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", /* CRITICAL: Tells TS to support Node ESM */
    "moduleResolution": "NodeNext", /* CRITICAL: Ensures correct file resolution */
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}